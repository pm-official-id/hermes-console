{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "bun run typecheck && bun run --filter '*' build",
    "typecheck:libs": "tsc --build",
    "typecheck": "bun run typecheck:libs && bun run --filter './artifacts/**' --filter './scripts' typecheck"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.63.3",
    "lightningcss-darwin-arm64": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
